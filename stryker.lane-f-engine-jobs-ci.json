{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F engine jobs/gates mutation slice. It is disjoint from engine AI and web slices; all base targets remain represented.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.engine-jobs.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": [
    "src/engine/jobs/JobRunner.ts",
    "src/engine/jobs/recovery.ts",
    "src/engine/jobs/queue.ts",
    "src/engine/jobs/stopFlow.ts",
    "src/engine/gate/GateLogic.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/lane-f-engine-jobs.html" },
  "jsonReporter": { "fileName": "reports/mutation/lane-f-engine-jobs.json" },
  "thresholds": { "high": 90, "low": 75, "break": 70 },
  "tempDirName": ".stryker-lane-f-engine-jobs-tmp",
  "concurrency": 1,
  "timeoutMS": 30000
}
