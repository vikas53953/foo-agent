diff --git a/test/integration/setting-not-memory.test.ts b/test/integration/setting-not-memory.test.ts
new file mode 100644
index 00000000..578d5263
--- /dev/null
+++ b/test/integration/setting-not-memory.test.ts
@@ -0,0 +1,101 @@
+// Spec: CR-0051 (X-209), 08-3 §12.4 as amended (the review leaves out a message whose intake kind was `setting`), 08-4 §25.6
+// (CR-0043 settings by chat). Real-AI run 30 (main 04f01dd, Claude CLI), U17: "Switch to dark mode" changed the theme with
+// "Changed: Theme → Dark. Undo", and the post-turn review also saved "Prefers dark mode"; Undo of the theme left that fact.
+// The words were an instruction to foo that the Settings line already records, not a fact about the user.
+import { afterEach, describe, expect, it } from 'vitest';
+import { sendMessage } from '../../src/main/store/composerQueries';
+import type { Settings } from '../../src/shared/settings';
+import { makeHarness, verified, type FakeLineIn, type Harness } from '../unit/m3-engine-helpers';
+
+let h: Harness | null = null;
+afterEach(() => {
+  h?.close();
+  h = null;
+});
+
+const realSleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
+const act = (decision: Record<string, unknown>, used: string[] = []) =>
+  `<say></say><act>${JSON.stringify({ decision, usedMemoryIds: used })}</act>`;
+const replyAct = (say: string, used: string[] = []) =>
+  `<say>${say}</say><act>${JSON.stringify({ decision: { kind: 'reply' }, usedMemoryIds: used })}</act>`;
+const intakeOn = (includes: string, reply: string): FakeLineIn => ({ match: { purpose: 'intake', promptIncludes: includes }, reply });
+
+function rig(script: FakeLineIn[], settings: (s: Settings) => Settings = (s) => s): Harness {
+  const v = verified();
+  return makeHarness({ script, settings: (s) => settings(v(s)), tools: {} });
+}
+
+/** A user message with a fixed id (the fake AI script names it as evidence), handed to the engine as main does. */
+function say(x: Harness, id: string, text: string): string {
+  x.clock.advance(1_000);
+  const r = sendMessage(
+    x.db,
+    { chatId: x.chatId, clientId: `k_${id}`, text },
+    { now: x.clock.now(), newId: () => id, waiting: false, attachment: () => undefined },
+  );
+  if (!r.ok) throw new Error(r.reason);
+  x.send('user.message', { messageId: id, chatId: x.chatId });
+  return id;
+}
+
+/** 08-3 §12.4: 20 s of quiet, then the review turn and its writes. */
+async function review(x: Harness): Promise<void> {
+  for (let i = 0; i < 5; i++) await realSleep(1);
+  x.clock.advance(20_000);
+  for (let i = 0; i < 20; i++) {
+    await realSleep(2);
+    await x.engine.memoryReview.idle();
+  }
+}
+
+const chips = (x: Harness) =>
+  x
+    .messages()
+    .filter((m) => m.marker_kind === 'memory_chip')
+    .map(
+      (m) =>
+        ({ text: m.text, ...(JSON.parse(String(m.why)) as { memoryChip: Record<string, unknown> }).memoryChip }) as Record<string, unknown>,
+    );
+const facts = (x: Harness) => x.db.prepare('SELECT * FROM memory_index ORDER BY learned_at').all() as Record<string, unknown>[];
+
+const DARK = act({ kind: 'setting', path: 'appearance.theme', value: 'dark' });
+const add = (o: Record<string, unknown>) => ({ op: 'add', scope: 'global', category: 'style', kind: 'preference', private: false, ...o });
+const reviewLine = (ops: unknown[]): FakeLineIn => ({
+  match: { purpose: 'memory_review' },
+  reply: `<act>${JSON.stringify({ ops })}</act>`,
+});
+
+describe('CR-0051 · a setting changed by chat is not also saved as a memory', () => {
+  it('run 30 U17: "Switch to dark mode" changes the theme and saves no "Prefers dark mode"', async () => {
+    h = rig([
+      intakeOn('dark mode', DARK),
+      reviewLine([add({ text: 'Prefers dark mode', provenance: 'said', evidenceMessageIds: ['m_d1'] })]),
+    ]);
+    const x = h;
+    say(x, 'm_d1', 'Switch to dark mode');
+    await x.idle();
+    await review(x);
+    expect(x.settings().appearance.theme).toBe('dark');
+    expect(facts(x)).toEqual([]);
+    expect(chips(x)).toEqual([]);
+    expect(x.turnsJsonl().some((t) => t.purpose === 'memory_review' && String(t.prompt).includes('dark mode'))).toBe(false);
+  });
+
+  it('a later message in the same chat is still reviewed', async () => {
+    h = rig([
+      intakeOn('dark mode', DARK),
+      intakeOn('vegetarian', replyAct('Noted.')),
+      reviewLine([add({ text: 'Vegetarian', provenance: 'said', evidenceMessageIds: ['m_v1'], category: 'food', kind: 'fact' })]),
+    ]);
+    const x = h;
+    say(x, 'm_d1', 'Switch to dark mode');
+    await x.idle();
+    say(x, 'm_v1', "I'm vegetarian");
+    await x.idle();
+    await review(x);
+    const turn = x.turnsJsonl().find((t) => t.purpose === 'memory_review')!;
+    expect(String(turn.prompt)).toContain("I'm vegetarian");
+    expect(String(turn.prompt)).not.toContain('Switch to dark mode');
+    expect(facts(x).map((f) => f.text)).toEqual(['Vegetarian']);
+  });
+});
