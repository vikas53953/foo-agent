@@ -98,4 +98,27 @@ describe('CR-0051 · a setting changed by chat is not also saved as a memory', (
     expect(String(turn.prompt)).not.toContain('Switch to dark mode');
     expect(facts(x).map((f) => f.text)).toEqual(['Vegetarian']);
   });
+
+  it('a review already waiting when the setting message arrives does not fire during its slow intake turn', async () => {
+    h = rig([
+      intakeOn('hi', replyAct('Hi!')),
+      { ...intakeOn('dark mode', DARK), delayMs: 25_000 },
+      reviewLine([add({ text: 'Prefers dark mode', provenance: 'said', evidenceMessageIds: ['m_d1'] })]),
+    ]);
+    const x = h;
+    say(x, 'm_h1', 'hi');
+    await x.idle();
+    // The reply to "hi" started the 20 s; 5 s later the setting message comes, and its turn takes 25 s.
+    x.clock.advance(4_000);
+    say(x, 'm_d1', 'Switch to dark mode');
+    for (let i = 0; i < 30; i++) {
+      await realSleep(2);
+      x.clock.advance(1_000);
+    }
+    await x.idle();
+    await review(x);
+    expect(x.settings().appearance.theme).toBe('dark');
+    expect(facts(x)).toEqual([]);
+    expect(x.turnsJsonl().some((t) => t.purpose === 'memory_review' && String(t.prompt).includes('dark mode'))).toBe(false);
+  });
 });
