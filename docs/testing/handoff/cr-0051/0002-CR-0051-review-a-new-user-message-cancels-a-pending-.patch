diff --git a/src/engine/memory/review.ts b/src/engine/memory/review.ts
index 5b377aa9..24b87e00 100644
--- a/src/engine/memory/review.ts
+++ b/src/engine/memory/review.ts
@@ -144,10 +144,18 @@ export class MemoryReview {
 
   constructor(private readonly d: ReviewDeps) {}
 
-  /** A user message arrived in `chatId`: the quiet period starts again. */
+  /**
+   * A user message arrived in `chatId`: the chat is not quiet while its turn runs, so a pending review waits for the next
+   * reply or finished job (`after`) to start the 20 s again. CR-0051: a review that fired mid-turn read a "Switch to dark
+   * mode" before its intake kind (`setting`) could leave it out.
+   */
   userMessage(chatId: string, seq: number): void {
     if (!this.floor.has(chatId)) this.floor.set(chatId, seq - 1);
-    if (this.timers.has(chatId)) this.schedule(chatId);
+    const pending = this.timers.get(chatId);
+    if (pending !== undefined) {
+      this.d.clock.clearTimeout(pending);
+      this.timers.delete(chatId);
+    }
   }
 
   /** J17 "don't remember this": the review never reads these messages. */
