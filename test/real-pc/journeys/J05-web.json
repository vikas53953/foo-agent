{
  "id": "J05-web",
  "title": "First real task with the internet (news + sources)",
  "spec": "07-1 J5; R1 sources/citations",
  "steps": [
    {
      "do": "send",
      "text": "What's the latest news about ISRO this week? Give me sources."
    },
    {
      "do": "waitReply",
      "timeoutMs": 240000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "news",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const after=rows.slice(rows.indexOf(me)+1);const foo=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"bubble-foo\"]')]).at(-1);const plan=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"card-plan\"]')]).at(-1);const text=(foo?.innerText||'')+' '+(plan?.innerText||'');return !!(foo||plan)&&/ISRO|news|source|search/i.test(text);})()"
    },
    {
      "do": "check",
      "tid": "bubble-sources"
    },
    {
      "do": "check",
      "tid": "bubble-citation"
    },
    {
      "do": "expectText",
      "tid": "bubble-foo",
      "last": true,
      "re": "SEARCH_BUSY|search(es)? (is|are) busy|every web search fails",
      "not": true
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
