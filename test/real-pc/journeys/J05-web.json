{
  "id": "J05-web",
  "title": "First real task with the internet (news + sources)",
  "spec": "07-1 J5; R1 sources/citations",
  "steps": [
    {
      "do": "send",
      "text": "What's the latest news about ISRO this week? Give me sources."
    },
    {
      "do": "waitReply",
      "timeoutMs": 240000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "news"
    },
    {
      "do": "clickIf",
      "tid": "card-plan-go"
    },
    {
      "do": "waitFor",
      "css": "[data-testid=\"bubble-sources\"], [data-testid=\"card-stuck\"], [data-testid=\"card-error\"]",
      "timeoutMs": 300000,
      "note": "the job's end: the answer with sources, or a stuck/error card (run 30 checked at the first live checklist)",
      "shot": "news-later"
    },
    {
      "do": "check",
      "tid": "bubble-sources"
    },
    {
      "do": "check",
      "tid": "bubble-citation"
    },
    {
      "do": "expectText",
      "tid": "bubble-foo",
      "last": true,
      "re": "SEARCH_BUSY|search(es)? (is|are) busy|every web search fails",
      "not": true
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
