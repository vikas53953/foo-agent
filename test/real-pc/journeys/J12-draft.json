{
  "id": "J12-draft",
  "title": "Draft an email (never sends)",
  "spec": "07-1 J12; M8 drafts",
  "steps": [
    {
      "do": "send",
      "text": "Draft an email to someone@example.com saying I'll be 15 minutes late to tomorrow's meeting"
    },
    {
      "do": "waitReply",
      "timeoutMs": 180000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "draft",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const after=rows.slice(rows.indexOf(me)+1);const text=after.map((r)=>r.innerText||'').join('\\n');const draft=after.some((r)=>r.querySelector('[data-testid=\"card-draft\"]'));return draft||(/draft|email|Gmail|someone@example.com|connect/i.test(text)&&!/sent successfully|email sent/i.test(text));})()"
    },
    {
      "do": "check",
      "tid": "card-draft"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
