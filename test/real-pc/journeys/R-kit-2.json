      "expectTid": "bubble-foo",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\"bubble-foo\"]')].at(-1);return !!b&&/(confirm|scheduled|booked|set for|[2-5]:?\\s?(am|pm))/i.test(b.innerText)})()",
