{
  "id": "QA1-batch1-recheck",
  "title": "QA re-check with real Claude: Vikas's batch-1 bugs and QA-X-F26 to F32 on the shipped build",
  "spec": "QA catalogue test/qa-explore/catalogue.ts (F26-F32); Vikas 26-27 Oct bug list; CR-0059, CR-0066, CR-0067, CR-0068",
  "covers": ["QA-X-F26", "QA-X-F27", "QA-X-F28", "QA-X-F29", "QA-X-F30", "QA-X-F31", "QA-X-F32"],
  "features": "shipped",
  "profile": "own",
  "gate": true,
  "steps": [
    {
      "do": "waitFor",
      "tid": "setup-welcome-start",
      "timeoutMs": 60000,
      "shot": "welcome",
      "expect": "Welcome card, step 1 of 2"
    },
    {
      "do": "click",
      "tid": "setup-welcome-start"
    },
    {
      "do": "waitFor",
      "css": "[data-testid=\"card-setup\"][data-row-id=\"ai_finder\"]",
      "timeoutMs": 60000,
      "shot": "finder",
      "expect": "Find your AI card; the Anthropic key row offers to add the key"
    },
    {
      "do": "wait",
      "ms": 20000,
      "shot": "finder-tested",
      "expect": "rows tested; the key row waits for a key"
    },
    {
      "do": "click",
      "css": "[data-testid=\"setup-ai-row\"][data-row-id=\"anthropic-key\"] [data-testid=\"setup-ai-row-action\"]",
      "note": "Add key on the Anthropic key row: opens the Secret box"
    },
    {
      "do": "waitFor",
      "tid": "card-secret-field",
      "timeoutMs": 30000,
      "shot": "secret-box",
      "expect": "Secret box asks for the Anthropic key"
    },
    {
      "do": "fill",
      "tid": "card-secret-field",
      "env": "ANTHROPIC_API_KEY",
      "note": "the key typed into foo's own Secret box, masked"
    },
    {
      "do": "click",
      "tid": "card-secret-save"
    },
    {
      "do": "wait",
      "ms": 30000,
      "shot": "key-tested",
      "expect": "the Anthropic key row shows works"
    },
    {
      "do": "clickIf",
      "tid": "setup-ai-pick-another",
      "note": "more than one AI works: pick the key, not the Claude app"
    },
    {
      "do": "clickIf",
      "css": "[data-testid=\"card-choice-option\"][data-option=\"anthropic-key\"]"
    },
    {
      "do": "clickIf",
      "tid": "setup-ai-use",
      "note": "only the key works: Use it"
    },
    {
      "do": "waitFor",
      "tid": "setup-skip-rest",
      "timeoutMs": 60000,
      "shot": "step2",
      "expect": "step 2 of 2: name card; the finder collapsed to Using Anthropic key"
    },
    {
      "do": "expectText",
      "css": "[data-testid=\"card-setup\"][data-row-id=\"ai_finder\"]",
      "re": "Anthropic key",
      "note": "foo uses the key, not the Claude app"
    },
    {
      "do": "click",
      "tid": "setup-skip-rest"
    },
    {
      "do": "wait",
      "ms": 10000,
      "shot": "first-chat",
      "expect": "warm hello with three things to try; composer unlocked"
    },
    {
      "do": "send",
      "text": "hi foo, ek line mein batao: chai ya coffee?"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q1-chat",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "a reply; 👀 never shows while foo answers (Vikas 27 Oct, QA-X-F27)"
    },
    {
      "do": "check",
      "css": "[data-testid^=\"chatlist-filter\"]",
      "count": 0,
      "shot": "q2-no-job-filters",
      "note": "QA (Vikas bug 3): jobs off, so no job filter chips"
    },
    {
      "do": "hover",
      "tid": "bubble-foo",
      "last": true
    },
    {
      "do": "click",
      "tid": "bubble-actions-retry",
      "last": true,
      "note": "QA (Vikas bug 1): Try again on the finished answer"
    },
    {
      "do": "wait",
      "ms": 20000
    },
    {
      "do": "expectText",
      "tid": "thread-log",
      "re": "Rewritten",
      "shot": "q3-try-again",
      "expect": "Try again rewrites the answer in place and says Rewritten"
    },
    {
      "do": "send",
      "text": "Please just reply OK."
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q4-ok",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "foo replies OK"
    },
    {
      "do": "click",
      "tid": "bubble-me",
      "last": true,
      "button": "right"
    },
    {
      "do": "click",
      "tid": "bubble-menu-delete"
    },
    {
      "do": "click",
      "css": "role=button[name=\"Delete\"]",
      "last": true,
      "note": "QA (Vikas bug 5): confirm the delete"
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "do": "expectText",
      "tid": "thread-log",
      "re": "deleted this message|message was deleted",
      "not": true,
      "shot": "q5-deleted",
      "expect": "the message leaves the chat; no 'You deleted this message' line"
    },
    {
      "do": "pasteSend",
      "text": "gamma\n\ndelta. Please just reply OK.",
      "shot": "q6-paste-blank-line",
      "expect": "QA-X-F26: a pasted blank line is sent once, exactly as pasted"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q6-reply",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "foo replies"
    },
    {
      "do": "paste",
      "text": "one\ntwo\n\nthree "
    },
    {
      "do": "paste",
      "text": "sk-ant-api03-qaFAKEkeyNOTrealABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    },
    {
      "do": "wait",
      "ms": 1000
    },
    {
      "do": "expectText",
      "tid": "composer-field",
      "re": "three\\s*•",
      "shot": "q7-key-mask",
      "expect": "QA-X-F28: the key's mask lands after \"three \", never inside it (a made-up key, never sent)"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "key",
      "key": "Control+A"
    },
    {
      "do": "key",
      "key": "Backspace"
    },
    {
      "do": "check",
      "css": "[data-testid=\"composer-field\"]",
      "note": "field cleared; the made-up key is never sent"
    },
    {
      "do": "send",
      "text": "Book a table for 2 tonight at a cafe in Delhi"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q8-job-off",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "QA-X-F32: foo's own fixed line that it can't do tasks yet",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\"bubble-foo\"]')].at(-1);return !!b&&/can.t do tasks for you yet/i.test(b.innerText)&&!/<\\/?say>/.test(b.innerText)&&!document.querySelector('[data-testid=\"card-checklist\"]')})()"
    },
    {
      "do": "send",
      "text": "remember that my sister's birthday is on 5 March"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q9-memory-off",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "QA-X-F29: exactly one bubble, foo can't remember yet; never 'Noted'",
      "expectJs": "(()=>{const all=[...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"bubble-me\"], [data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"]')];const me=all.map(b=>b.dataset.testid).lastIndexOf('bubble-me');const after=all.slice(me+1);return after.length===1&&!/noted|i.ve saved|i.ll remember/i.test(after[0].innerText)&&!/<\\/?say>/.test(after[0].innerText)})()"
    },
    {
      "do": "send",
      "text": "Switch to dark mode"
    },
    {
      "do": "waitFor",
      "css": "html[data-theme=\"dark\"]",
      "timeoutMs": 120000,
      "shot": "q10-dark",
      "note": "QA-X-F30: a theme ask right after a memory ask still changes the theme (never the memory line)"
    },
    {
      "do": "wait",
      "ms": 4000
    },
    {
      "do": "send",
      "text": "did you book the table?"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q11-no-tags",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "QA-X-F31: an honest no, shown once, never raw <say> tags",
      "expectJs": "(()=>{const all=[...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"bubble-me\"], [data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"]')];const me=all.map(b=>b.dataset.testid).lastIndexOf('bubble-me');const after=all.slice(me+1);if(after.length!==1)return false;const t=after[0].innerText;return !/<\\/?say>/.test(t)&&/(can.?t|cannot|not able|unable|haven.?t|didn.?t|not yet|nahi)/i.test(t)})()"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
