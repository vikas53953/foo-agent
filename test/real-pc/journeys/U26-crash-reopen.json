{
  "id": "U26-crash-reopen",
  "title": "foo crashes and is reopened at once: a window must appear",
  "spec": "07 J-crash recovery (CR-0029, X-187); single-instance lock",
  "covers": ["crash recovery", "single instance"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "check",
      "soft": true,
      "tid": "composer-field",
      "note": "foo is open"
    },
    {
      "do": "crashRelaunch",
      "shot": "after-reopen",
      "expect": "kill only the main foo.exe, reopen straight away: a foo window shows (not a silent quit)"
    },
    {
      "do": "crashRelaunch",
      "gapMs": 1500,
      "shot": "after-reopen-1500ms",
      "expect": "same, reopening 1.5 s after the crash"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
