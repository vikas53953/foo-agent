{
  "id": "R1-rich",
  "title": "Rich replies: table, steps, numbers",
  "spec": "CR-0022 R1",
  "steps": [
    {
      "do": "send",
      "text": "Make a table comparing 3 budget phones under 20000 rupees"
    },
    {
      "do": "waitReply",
      "timeoutMs": 180000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "table",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const after=rows.slice(rows.indexOf(me)+1);const foo=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"bubble-foo\"]')]).at(-1);const plan=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"card-plan\"]')]).at(-1);const text=(foo?.innerText||'')+' '+(plan?.innerText||'');return !!(foo||plan)&&/phone|20000|table|compar/i.test(text);})()"
    },
    {
      "do": "clickIf",
      "tid": "card-plan-go",
      "note": "press Go on the plan (starts the job; spending still needs Approve, which is never tapped)"
    },
    {
      "do": "wait",
      "ms": 150000,
      "shot": "table-after-go"
    },
    {
      "do": "check",
      "tid": "bubble-table"
    },
    {
      "do": "dump",
      "name": "thread-table"
    },
    {
      "do": "send",
      "text": "Plan a 3 day trip to Jaipur for my parents"
    },
    {
      "do": "waitReply",
      "timeoutMs": 240000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "trip",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const after=rows.slice(rows.indexOf(me)+1);const foo=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"bubble-foo\"]')]).at(-1);const plan=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"card-plan\"]')]).at(-1);const text=(foo?.innerText||'')+' '+(plan?.innerText||'');return !!(foo||plan)&&/Jaipur|trip|day|parents/i.test(text);})()"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
