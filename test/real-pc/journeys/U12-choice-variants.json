{
  "id": "U12-choice-variants",
  "title": "Choice card: pick by click, by typing, by reaction 1️⃣, Something else",
  "spec": "05-1 §5.4 Choice, 10-2 §C.4 Choice (C3), AT-035",
  "covers": ["C.4 Choice (C3)", "C.3 Reactions", "AT-035"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "send",
      "text": "Help me pick a weekend activity in Bengaluru, give me 3 options to choose from"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "choice",
      "expect": "Choice card with 3 options, Best fit tag, Something else",
      "ref": "BP-CARD-03",
      "expectJs": "(()=>{const c=document.querySelector('[data-testid=\\\"card-choice\\\"]');return !!c&&c.querySelectorAll('[data-testid=\\\"card-choice-option\\\"]').length>=3;})()",
      "note": "C.4 Choice (C3): choice card has at least three executable options"
    },
    {
      "do": "click",
      "tid": "bubble-foo",
      "last": true,
      "button": "right"
    },
    {
      "do": "click",
      "tid": "bubble-menu-react"
    },
    {
      "do": "click",
      "tid": "bubble-react-option"
    },
    {
      "do": "check",
      "tid": "bubble-reaction",
      "note": "C.3 Reactions: reaction picker adds a reaction chip to the assistant bubble"
    },
    {
      "do": "shotEl",
      "tid": "card-choice",
      "last": true,
      "name": "choice-card",
      "soft": true,
      "ref": "BP-CARD-03"
    },
    {
      "do": "send",
      "text": "the second one"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "typed-pick",
      "expect": "typed answer picks option 2; card collapses \"question → answer\"",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);return !!b&&/second|2/i.test(b.innerText||'');})()",
      "note": "C.4 Choice (C3); AT-035: typed choice branch collapses to an answered option (reaction-choice branch remains unexercised)"
    },
    {
      "do": "send",
      "text": "Now give me 3 dinner options to choose from"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "choice-2",
      "expect": "another Choice card",
      "expectJs": "(()=>{const c=document.querySelector('[data-testid=\\\"card-choice\\\"]');return !!c&&c.querySelectorAll('[data-testid=\\\"card-choice-option\\\"]').length>=3;})()",
      "note": "C.4 Choice (C3): second choice card has executable options"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-choice-something-else",
      "last": true
    },
    {
      "do": "wait",
      "ms": 600,
      "shot": "something-else",
      "expect": "composer hint for my own answer"
    },
    {
      "do": "send",
      "text": "Actually just a home-cooked dal chawal"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "own-answer",
      "expect": "foo takes my own answer",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);return !!b&&/dal|chawal|home[- ]cooked/i.test(b.innerText||'');})()",
      "note": "C.4 Choice (C3): assistant accepts the user-provided alternative"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
