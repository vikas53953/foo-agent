{
  "id": "U07-composer",
  "title": "Composer: multi-line, attach menu, emoji, Esc, draft kept after restart",
  "spec": "04 §13–§16, 10-2 §C.3 Composer",
  "covers": ["C.3 Composer"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "shot",
      "name": "composer",
      "expect": "composer: + attach, field \"Message foo, or hold Ctrl+Space to talk\", mic/send 36px",
      "ref": "BP-COMP-01"
    },
    {
      "do": "check",
      "tid": "composer",
      "note": "C.3 Composer: composer surface is present"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "composer-field"
    },
    {
      "do": "key",
      "key": "Shift+Enter"
    },
    {
      "do": "fill",
      "tid": "composer-field",
      "value": "line one\nline two\nline three",
      "soft": true
    },
    {
      "do": "wait",
      "ms": 400,
      "shot": "multiline",
      "expect": "composer grows upward for 3 lines",
      "ref": "BP-COMP-02"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "composer-attach"
    },
    {
      "do": "wait",
      "ms": 500,
      "shot": "attach-menu",
      "expect": "attach menu: Files, Screenshot, Secret, Emoji",
      "ref": "BP-COMP-05"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "composer-attach-menu-emoji"
    },
    {
      "do": "wait",
      "ms": 500,
      "shot": "emoji",
      "expect": "emoji picker"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "expectText",
      "tid": "composer-field",
      "re": "line one[\\s\\S]*line three",
      "note": "C.3 Composer: multiline composer text preserves all three lines"
    },
    {
      "do": "fill",
      "tid": "composer-field",
      "value": "a draft I did not send",
      "soft": true
    },
    {
      "do": "relaunch"
    },
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "expectText",
      "tid": "composer-field",
      "re": "a draft I did not send",
      "note": "C.3 Composer: draft text is restored in the composer after relaunch"
    },
    {
      "do": "wait",
      "ms": 1000,
      "shot": "draft-restored",
      "expect": "the unsent draft is back in the composer"
    },
    {
      "do": "eval",
      "note": "draft restored: evaluation is diagnostic only",
      "js": "(document.querySelector('[data-testid=composer-field]') || {}).value || (document.querySelector('[data-testid=composer-field]') || {}).innerText"
    },
    {
      "do": "fill",
      "tid": "composer-field",
      "value": "",
      "soft": true
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
