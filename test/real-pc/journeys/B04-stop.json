{
  "id": "B04-stop",
  "title": "Start a job then stop it by typing stop",
  "spec": "AT-077, AT-107, AT-080, J18",
  "steps": [
    {
      "do": "send",
      "text": "Find the 3 cheapest flights from Delhi to Mumbai next Friday and compare them"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "flight-plan",
      "note": "AT-077/AT-107: the stop fixture first renders a real plan or reply",
      "expectJs": "(()=>!!document.querySelector('[data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"], [data-testid=\"thread-log\"] [data-testid=\"card-plan\"]'))()"
    },
    {
      "do": "clickIf",
      "tid": "card-plan-go"
    },
    {
      "do": "wait",
      "ms": 40000,
      "shot": "flight-working"
    },
    {
      "do": "send",
      "text": "stop"
    },
    {
      "do": "waitReply",
      "timeoutMs": 60000,
      "shot": "after-stop",
      "expect": "AT-077: stops within 1 s; reply lists exactly what was done; badge \u26d4",
      "note": "AT-077/AT-107: stop is accepted only with a rendered stop report and stopped badge",
      "expectJs": "(()=>{const foo=[...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"]')].pop();const report=(foo?.innerText||'');const stopped=[...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"]')].some((b)=>b.getAttribute('data-state')==='stopped');return !!foo&&/(stopp|nothing.*(running|booked|paid|sent))/i.test(report)&&stopped;})()"
    },
    {
      "do": "check",
      "css": "[data-testid=\"card-approval\"][data-card-state=\"PENDING\"]",
      "count": 0,
      "note": "AT-080: stop leaves no pending approval card exposed"
    },
    {
      "do": "check",
      "css": "[data-testid=\"card-checklist\"][data-card-state=\"stopped\"]",
      "count": 1,
      "note": "AT-107: the working job's checklist is rendered stopped after the user stop"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
