{
  "id": "B05-restart",
  "title": "Quit mid-job and reopen: job resumes",
  "spec": "AT-089, AT-118, J19/J20",
  "steps": [
    {
      "do": "send",
      "text": "Find the opening hours of the National Museum in Delhi and the ticket price"
    },
    {
      "do": "waitReply",
      "timeoutMs": 60000,
      "shot": "museum-start",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const after=rows.slice(rows.indexOf(me)+1);const foo=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"bubble-foo\"]')]).at(-1);const plan=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"card-plan\"]')]).at(-1);const text=(foo?.innerText||'')+' '+(plan?.innerText||'');return !!(foo||plan)&&/museum|ticket|opening|hours/i.test(text);})()"
    },
    {
      "do": "clickIf",
      "tid": "card-plan-go"
    },
    {
      "do": "wait",
      "ms": 8000
    },
    {
      "do": "crashRelaunch"
    },
    {
      "do": "wait",
      "ms": 8000,
      "shot": "after-reopen",
      "expect": "AT-118: recovery card; job resumes (WAITING \u2192 WORKING)"
    },
    {
      "do": "check",
      "css": "[data-testid=\"card-error\"][data-card-state=\"asking\"]",
      "count": 1,
      "note": "AT-118: reopen renders the asking recovery card"
    },
    {
      "do": "expectText",
      "tid": "card-error",
      "last": true,
      "re": "closed unexpectedly|Pick up where I left off",
      "note": "AT-118: recovery copy is present on the actual card"
    },
    {
      "do": "check",
      "tid": "card-error-fix",
      "count": 1,
      "note": "AT-118: the recovery card exposes its resume action"
    },
    {
      "do": "wait",
      "ms": 150000,
      "shot": "after-reopen-later"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
