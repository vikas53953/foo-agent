{
  "id": "B07-live",
  "title": "Watch live, take over, hand back, stop",
  "spec": "AT-058, AT-272, AT-078, J18",
  "steps": [
    {
      "do": "send",
      "text": "Open the Indian Railways IRCTC website and check the train timings from New Delhi to Agra tomorrow morning"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "irctc",
      "note": "AT-058/AT-078/AT-079/AT-272: the browser job must first produce an actual plan or reply",
      "expectJs": "(()=>!!document.querySelector('[data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"], [data-testid=\"thread-log\"] [data-testid=\"card-plan\"]'))()"
    },
    {
      "do": "clickIf",
      "tid": "card-plan-go"
    },
    {
      "do": "wait",
      "ms": 45000
    },
    {
      "do": "clickIf",
      "tid": "chat-header-watch-live"
    },
    {
      "do": "wait",
      "ms": 4000,
      "shot": "live"
    },
    {
      "do": "check",
      "css": "[data-testid=\"live-root\"][data-state=\"live\"]",
      "count": 1,
      "note": "AT-079: the live window exposes the live state"
    },
    {
      "do": "check",
      "css": "[data-testid=\"live-picture\"][data-masked=\"true\"]",
      "count": 1,
      "note": "AT-079: the live picture is marked masked"
    },
    {
      "do": "clickIf",
      "tid": "live-take-over"
    },
    {
      "do": "wait",
      "ms": 3000,
      "shot": "taken-over"
    },
    {
      "do": "check",
      "css": "[data-testid=\"live-root\"][data-state=\"in_control\"]",
      "count": 1,
      "note": "AT-058/AT-272: Take over moves the actual live window into control"
    },
    {
      "do": "check",
      "tid": "live-control-bar",
      "count": 1,
      "note": "AT-272: control mode exposes the hand-back bar"
    },
    {
      "do": "clickIf",
      "tid": "live-hand-back"
    },
    {
      "do": "wait",
      "ms": 3000,
      "shot": "handed-back"
    },
    {
      "do": "check",
      "css": "[data-testid=\"live-root\"][data-state=\"live\"]",
      "count": 1,
      "note": "AT-058/AT-272: hand back returns the live window to foo"
    },
    {
      "do": "clickIf",
      "tid": "live-stop"
    },
    {
      "do": "wait",
      "ms": 8000,
      "shot": "stopped"
    },
    {
      "do": "check",
      "tid": "live-root",
      "count": 0,
      "note": "AT-078: after stop the live window is closed rather than left interactive"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
