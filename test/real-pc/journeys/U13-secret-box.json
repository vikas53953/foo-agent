{
  "id": "U13-secret-box",
  "title": "Secret box: type a fake key, show/hide, save, replace",
  "spec": "05-2 §5.8 Secret box, 10-2 §C.4 Secret box (C7), ART-08a",
  "covers": ["C.4 Secret box (C7) + code box + card form", "C.4 Paste catcher (C8)"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "click",
      "soft": true,
      "tid": "composer-attach"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "composer-attach-menu-secret"
    },
    {
      "do": "wait",
      "ms": 1500,
      "shot": "secret",
      "expect": "Secret box card: Name field, masked key field, eye toggle, Save (CR-0057)",
      "ref": "BP-CARD-07"
    },
    {
      "do": "fill",
      "css": "[data-testid=\"card-secret-field\"][data-index=\"0\"]",
      "value": "Test key",
      "soft": true,
      "last": true
    },
    {
      "do": "fill",
      "css": "[data-testid=\"card-secret-field\"][data-index=\"1\"]",
      "value": "sk-test-0000000000000000000000000000",
      "soft": true,
      "last": true
    },
    {
      "do": "wait",
      "ms": 300,
      "shot": "typed",
      "expect": "value masked"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-secret-eye",
      "last": true
    },
    {
      "do": "wait",
      "ms": 300,
      "shot": "shown",
      "expect": "value shown after eye"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-secret-eye",
      "last": true
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-secret-save",
      "last": true
    },
    {
      "do": "wait",
      "ms": 2000,
      "shot": "saved",
      "expect": "\"Test key · saved {date}\", only Replace offered; value never shown again",
      "ref": "BP-CARD-08"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-secret-replace",
      "last": true
    },
    {
      "do": "wait",
      "ms": 800,
      "shot": "replace",
      "expect": "empty field to replace"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-secret-cancel",
      "last": true
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
