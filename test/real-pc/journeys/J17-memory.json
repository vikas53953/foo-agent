{
  "id": "J17-memory",
  "title": "Remember, view and forget",
  "spec": "07-1 J17; 06 memory page; M6",
  "steps": [
    {
      "do": "send",
      "text": "Please remember that my favourite food is South Indian."
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "remember",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const after=rows.slice(rows.indexOf(me)+1);const text=after.map((r)=>r.innerText||'').join('\\n');const undo=after.some((r)=>r.querySelector('[data-testid=\"thread-memory-undo\"]'));return undo||/remember|South Indian|saved|memory/i.test(text);})()"
    },
    {
      "do": "click",
      "tid": "sidebar-more"
    },
    {
      "do": "click",
      "tid": "sidebar-menu-memory",
      "expect": "fact listed in plain words with source"
    },
    {
      "do": "wait",
      "ms": 2000,
      "shot": "memory-page",
      "expect": "fact listed in plain words with source"
    },
    {
      "do": "check",
      "tid": "memory-row"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "send",
      "text": "What is my favourite food?"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "recall",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const b=rows.slice(rows.indexOf(me)+1).flatMap((r)=>[...r.querySelectorAll('[data-testid=\"bubble-foo\"]')]).at(-1);return !!b&&/South Indian|favourite food|favorite food/i.test(b.innerText||'');})()"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
