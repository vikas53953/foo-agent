{
  "id": "QA3-languages-batch1",
  "title": "Hindi, Punjabi and Hinglish with real Claude on the batch-1 build",
  "spec": "QA audit 28 Oct: batch-1 items not yet proven with real Claude",
  "covers": ["batch-1 chat"],
  "features": "shipped",
  "profile": "own",
  "gate": true,
  "steps": [
    {
      "do": "waitFor",
      "tid": "setup-welcome-start",
      "timeoutMs": 60000,
      "shot": "welcome",
      "expect": "Welcome card, step 1 of 2",
      "feature": "install"
    },
    {
      "do": "click",
      "tid": "setup-welcome-start"
    },
    {
      "do": "waitFor",
      "css": "[data-testid=\"card-setup\"][data-row-id=\"ai_finder\"]",
      "timeoutMs": 60000,
      "shot": "finder",
      "expect": "Find your AI card; the Anthropic key row offers to add the key",
      "feature": "ai"
    },
    {
      "do": "wait",
      "ms": 20000,
      "shot": "finder-tested",
      "expect": "rows tested; the key row waits for a key",
      "feature": "ai"
    },
    {
      "do": "click",
      "css": "[data-testid=\"setup-ai-row\"][data-row-id=\"anthropic-key\"] [data-testid=\"setup-ai-row-action\"]",
      "note": "Add key on the Anthropic key row: opens the Secret box"
    },
    {
      "do": "waitFor",
      "tid": "card-secret-field",
      "timeoutMs": 30000,
      "shot": "secret-box",
      "expect": "Secret box asks for the Anthropic key",
      "feature": "ai"
    },
    {
      "do": "fill",
      "tid": "card-secret-field",
      "env": "ANTHROPIC_API_KEY",
      "note": "the key typed into foo's own Secret box, masked"
    },
    {
      "do": "click",
      "tid": "card-secret-save"
    },
    {
      "do": "wait",
      "ms": 30000,
      "shot": "key-tested",
      "expect": "the Anthropic key row shows works",
      "feature": "ai"
    },
    {
      "do": "clickIf",
      "tid": "setup-ai-pick-another",
      "note": "more than one AI works: pick the key, not the Claude app"
    },
    {
      "do": "clickIf",
      "css": "[data-testid=\"card-choice-option\"][data-option=\"anthropic-key\"]"
    },
    {
      "do": "clickIf",
      "tid": "setup-ai-use",
      "note": "only the key works: Use it"
    },
    {
      "do": "waitFor",
      "tid": "setup-skip-rest",
      "timeoutMs": 60000,
      "shot": "step2",
      "expect": "step 2 of 2: name card; the finder collapsed to Using Anthropic key",
      "feature": "name"
    },
    {
      "do": "expectText",
      "css": "[data-testid=\"card-setup\"][data-row-id=\"ai_finder\"]",
      "re": "Anthropic key",
      "note": "foo uses the key, not the Claude app"
    },
    {
      "do": "click",
      "tid": "setup-skip-rest"
    },
    {
      "do": "wait",
      "ms": 10000,
      "shot": "first-chat",
      "expect": "warm hello with three things to try; composer unlocked",
      "feature": "chat"
    },
    {
      "do": "send",
      "text": "नमस्ते! आज शाम के लिए कोई आसान सब्ज़ी बताओ, दो लाइन में।"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q3-hindi",
      "feature": "chat",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "Hindi in Devanagari is answered in Devanagari",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"]')].at(-1);if(!b)return false;const t=b.innerText;return /[\\u0900-\\u097F]{4}/.test(t)&&!/<\\/?say>/.test(t)})()"
    },
    {
      "do": "send",
      "text": "ਸਤ ਸ੍ਰੀ ਅਕਾਲ! ਮੰਮੀ ਦੇ ਜਨਮਦਿਨ ਲਈ ਕਿਹੜਾ ਕੇਕ ਵਧੀਆ ਰਹੇਗਾ? ਦੋ ਲਾਈਨਾਂ ਵਿੱਚ।"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q3-punjabi",
      "feature": "chat",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "Punjabi in Gurmukhi is answered in Gurmukhi, letters shown properly",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"]')].at(-1);if(!b)return false;const t=b.innerText;return /[\\u0A00-\\u0A7F]{4}/.test(t)&&!/<\\/?say>/.test(t)})()"
    },
    {
      "do": "send",
      "text": "yaar kal office jaldi jaana hai, 9 baje pahunchna hai aur raste mein 45 min lagte hain. alarm kitne baje lagau?"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "shot": "q3-hinglish",
      "feature": "chat",
      "neverCss": "[data-testid=\"thread-log\"] [data-testid=\"bubble-badge\"][data-state=\"seen\"]",
      "expect": "Hinglish is answered in Hinglish with a sensible alarm time (7 to 8 am)",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"bubble-foo\"]')].at(-1);if(!b)return false;const t=b.innerText;return /\\b(7|8)([:.]\\d{2})?\\b/.test(t)&&!/<\\/?say>/.test(t)})()"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
