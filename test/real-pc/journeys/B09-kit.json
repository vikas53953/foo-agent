{
  "id": "B09-kit",
  "title": "Rich reply pieces: calculator, map, chart, compare, timer, form",
  "spec": "R1 AT-340..AT-371",
  "steps": [
    {
      "do": "send",
      "text": "Make an EMI calculator for a home loan of 50 lakh at 8.5% for 20 years"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "emi",
      "expect": "AT-347 calculator recomputes",
      "expectKit": "kit-calculator"
    },
    {
      "do": "send",
      "text": "Show the 5 places to visit in Jaipur on a map"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "map",
      "expect": "AT-341 numbered stops, dashed route, Open in Maps chip",
      "expectKit": "kit-map-stops"
    },
    {
      "do": "send",
      "text": "Show a chart of India's GDP growth for the last 5 years"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "chart",
      "expect": "AT-340 one hue, number rules",
      "expectKit": "kit-line-chart"
    },
    {
      "do": "send",
      "text": "Compare iPhone 16, Pixel 9 and Galaxy S25 side by side and highlight the best value"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "compare",
      "expect": "AT-343 highlighted column with why",
      "expectKit": "kit-compare"
    },
    {
      "do": "send",
      "text": "Set a 2 minute timer for my tea"
    },
    {
      "do": "waitReply",
      "timeoutMs": 90000,
      "shot": "timer",
      "expect": "AT-346 timer runs",
      "expectKit": "kit-timed-checklist"
    },
    {
      "do": "send",
      "text": "Give me a short form to plan a birthday party: date, guests, budget"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "form",
      "expect": "AT-351 up to 6 fields, submit one action",
      "expectKit": "kit-short-form"
    },
    {
      "do": "send",
      "text": "Make me an interactive page to track my monthly expenses"
    },
    {
      "do": "waitReply",
      "timeoutMs": 200000,
      "shot": "ai-page",
      "expect": "AT-358..362 sealed page, status line first",
      "expectTid": "ai-page",
      "expectJs": "['ready', 'kept'].includes([...document.querySelectorAll('[data-testid=\"thread-log\"] [data-testid=\"ai-page\"]')].pop()?.dataset.state)"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
