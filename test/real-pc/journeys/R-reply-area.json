{
  "id": "R-reply-area",
  "title": "Group R reply sender and action ownership",
  "spec": "07 §11.5 Group R; AT-428, AT-430",
  "covers": [
    "AT-428",
    "AT-430"
  ],
  "steps": [
    {
      "do": "send",
      "text": "hi",
      "note": "AT-428: clean ask"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "expectTid": "bubble-foo",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\"bubble-foo\"]')].at(-1);return !!b?.querySelector('[data-testid=\"bubble-sender\"]')})()",
      "note": "AT-428: clean",
      "shot": "at-428-clean"
    },
    {
      "do": "expectText",
      "tid": "bubble-foo",
      "last": true,
      "re": "hi|hello|namaste",
      "note": "AT-428: clean result"
    },
    {
      "do": "send",
      "text": "hii",
      "note": "AT-428: messy typo ask"
    },
    {
      "do": "waitReply",
      "timeoutMs": 120000,
      "expectTid": "bubble-foo",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\"bubble-foo\"]')].at(-1);return !!b?.querySelector('[data-testid=\"bubble-sender\"]')})()",
      "note": "AT-428: messy typo",
      "shot": "at-428-messy-typo"
    },
    {
      "do": "expectText",
      "tid": "bubble-foo",
