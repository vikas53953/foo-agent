{
  "id": "U03-select-delete",
  "title": "Select messages, copy them, delete one (keep)",
  "spec": "04 §9, 03-2 selection header, 10-2 §C.3",
  "covers": ["C.3 Your bubble + status badge", "C.2 Headers (left + main)"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "send",
      "text": "Say hello in Hindi"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "hello",
      "expect": "short reply",
      "expectJs": "(()=>{const me=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-me\\\"]')].at(-1);const foo=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);return !!foo&&(foo.innerText||'').trim().length>0&&!!me?.querySelector('[data-testid=\\\"bubble-tick\\\"],[data-testid=\\\"bubble-badge\\\"]');})()",
      "note": "C.3 Your bubble + status badge: the sent bubble has a status indicator and the assistant reply is non-empty"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "bubble-me",
      "last": true,
      "button": "right"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "bubble-menu-select"
    },
    {
      "do": "wait",
      "ms": 600,
      "shot": "select-mode",
      "expect": "selection header with count, Copy, Delete, Cancel; check circles on bubbles"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "bubble-select-check",
      "last": true
    },
    {
      "do": "wait",
      "ms": 400,
      "shot": "two-selected",
      "expect": "count 2"
    },
    {
      "do": "expectText",
      "re": "2",
      "tid": "chat-header-selection-count",
      "note": "C.2 Headers (left + main): selection header count is rendered as 2"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "chat-header-selection-copy"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "chat-header-selection-cancel"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "bubble-me",
      "last": true,
      "button": "right"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "bubble-menu-delete"
    },
    {
      "do": "wait",
      "ms": 600,
      "shot": "delete-dialog",
      "expect": "confirm dialog; Esc keeps the message",
      "ref": "UX-23-04"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "check",
      "tid": "bubble-me",
      "note": "C.3 Your bubble + status badge: the user bubble remains after cancelling deletion"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
