{
  "id": "U08-rich-text",
  "title": "foo bubbles: code block copy, table, links, list, sources",
  "spec": "04 §3–§5, 10-2 §C.3 foo bubble, R1",
  "covers": ["C.3 foo / helper bubble", "C.9 Rich replies"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "send",
      "text": "Show me a tiny Python hello world in a code block"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "code",
      "expect": "code block in mono with a Copy button",
      "ref": "BP-MSG-03",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);return !!b?.querySelector('pre,code')&&!!b.querySelector('[data-testid=\\\"bubble-code-copy\\\"]');})()",
      "note": "C.3 foo / helper bubble; C.9 Rich replies: latest reply contains code and its copy control"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "bubble-code-copy",
      "last": true
    },
    {
      "do": "send",
      "text": "Make a 3-row table of Indian states and capitals"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "table",
      "expect": "table renders (or label: value lines), not raw pipes",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);const t=b?.innerText||'';return !!b&&(!!b.querySelector('table')||/state.*capital|capital.*state/i.test(t))&&!/\\|.*\\|/.test(t);})()",
      "note": "C.9 Rich replies: latest reply renders a table or a structured state/capital response without raw pipe rows"
    },
    {
      "do": "send",
      "text": "Give me the link to the Indian Railways website"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "link",
      "expect": "a clickable link; right-click shows open/copy",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);return !!b?.querySelector('a[href],[data-testid=\\\"bubble-autolink\\\"]');})()",
      "note": "C.3 foo / helper bubble; C.9 Rich replies: latest reply exposes an actual link"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "bubble-autolink",
      "last": true,
      "button": "right"
    },
    {
      "do": "wait",
      "ms": 500,
      "shot": "link-menu",
      "expect": "link menu: Open, Copy"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
