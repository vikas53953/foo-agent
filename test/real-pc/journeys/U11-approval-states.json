{
  "id": "U11-approval-states",
  "title": "Approval card: pending, Not now (declined), Change (never Approve)",
  "spec": "05-1 §5.7 Approval, 10-2 §C.4 Approval (C4), Article 6",
  "covers": ["C.4 Approval (C4)", "C.4 Choice (C3)"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "send",
      "text": "Book me a table for 2 at a vegetarian restaurant in Connaught Place, Delhi this Saturday 8 PM"
    },
    {
      "do": "waitReply",
      "timeoutMs": 240000,
      "shot": "ask",
      "expect": "options or a plan; never books without an Approval card",
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);return !!b&&(!!b.querySelector('[data-testid=\\\"card-choice\\\"],[data-testid=\\\"card-tiles\\\"],[data-testid=\\\"card-plan\\\"]')||/approval|option|plan/i.test(b.innerText||''));})()",
      "note": "C.4 Choice (C3): the initial assistant reply presents a bounded choice, tiles, or plan before approval"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-plan-go",
      "last": true
    },
    {
      "do": "wait",
      "ms": 120000,
      "shot": "options",
      "expect": "restaurant options as a Choice/tiles card"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-tiles-option",
      "last": true
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-choice-option",
      "last": true
    },
    {
      "do": "wait",
      "ms": 90000,
      "shot": "approval",
      "expect": "Approval card PENDING: accent top edge, lock, impact line, Book table / Change / Not now",
      "ref": "BP-CARD-04"
    },
    {
      "do": "waitFor",
      "tid": "card-approval",
      "timeoutMs": 30000,
      "note": "C.4 Approval (C4): pending approval card is present before any approval action"
    },
    {
      "do": "shotEl",
      "tid": "card-approval",
      "last": true,
      "name": "approval-card",
      "soft": true,
      "ref": "BP-CARD-04"
    },
    {
      "do": "send",
      "text": "yes"
    },
    {
      "do": "waitReply",
      "timeoutMs": 30000,
      "expectJs": "(()=>{const b=[...document.querySelectorAll('[data-testid=\\\"thread-log\\\"] [data-testid=\\\"bubble-foo\\\"]')].at(-1);const card=document.querySelector('[data-testid=\\\"card-approval\\\"]');return !!card&&/approve|approval|pending|not now|tap/i.test((b?.innerText||'')+' '+(card.innerText||''));})()",
      "note": "C.4 Approval (C4): typed yes leaves the approval pending and produces an approval-related response"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-approval-not-now",
      "last": true
    },
    {
      "do": "wait",
      "ms": 3000,
      "shot": "declined",
      "expect": "card DECLINED; nothing booked"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "card-approval-ask-again",
      "last": true
    },
    {
      "do": "wait",
      "ms": 2000,
      "shot": "ask-again",
      "expect": "Ask me again shows a fresh pending card or note"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
