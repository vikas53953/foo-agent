{
  "id": "B06-booking-options",
  "title": "Restaurant options without booking",
  "spec": "AT-036, J9, AT-108, AT-310, AT-311",
  "steps": [
    {
      "do": "send",
      "text": "Are there tables at a good Italian place in Bandra, Mumbai this Saturday at 8pm for 2?"
    },
    {
      "do": "waitReply",
      "timeoutMs": 180000,
      "shot": "italian"
    },
    {
      "do": "clickIf",
