    },
    {
      "do": "wait",
      "ms": 180000,
      "shot": "italian-later",
      "expect": "options shown; no booking Approval card until I say book"
    },
    {
      "do": "check",
      "tid": "card-approval",
      "count": 0
    },
    {
      "do": "check",
      "tid": "card-choice",
      "soft": true
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
