{
  "id": "U22-face-polish",
  "title": "Living face: thinking while working, resting; motion off in settings",
  "spec": "02 §F15.9 living face, 10-2 §C.7, §C.8",
  "covers": ["C.7.1", "C.7.4", "C.8 Quiet premium polish"],
  "steps": [
    {
      "do": "openChat",
      "name": "foo",
      "soft": true
    },
    {
      "do": "send",
      "text": "Write a 4-line poem about monsoon in Mumbai"
    },
    {
      "do": "waitFor",
      "css": "[data-testid=\"thread-thinking\"] [data-face][data-state=\"thinking\"][data-size=\"26\"]",
      "timeoutMs": 15000,
      "transient": true,
      "shot": "thinking",
      "note": "C.7.4: while the request is in flight, the transient row exposes only the 26px Thinking face"
    },
    {
      "do": "waitReply",
      "timeoutMs": 150000,
      "shot": "poem",
      "expectJs": "(()=>{const f=document.querySelector('[data-testid=\"chat-header-avatar\"] [data-face]');return f?.getAttribute('data-state')==='resting'&&!document.querySelector('[data-testid=\"thread-thinking\"]');})()",
      "note": "C.7.1: the sampled reply settles back to a resting header face and removes the transient Thinking row"
    },
    {
      "do": "shotEl",
      "tid": "chat-header-avatar",
      "name": "face",
      "soft": true
    },
    {
      "do": "key",
      "key": "Control+,"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "settings-nav-appearance"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "settings-row-appearance-face-motion"
    },
    {
      "do": "waitFor",
      "css": "[data-testid=\"chat-header-avatar\"] [data-face][data-motion-face=\"off\"]",
      "timeoutMs": 10000,
      "shot": "face-motion",
      "note": "C.8 Quiet premium polish: the face motion setting leaves the header face with data-motion-face=off"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "click",
      "soft": true,
      "tid": "screen-back"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
