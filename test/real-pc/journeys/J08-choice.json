{
  "id": "J08-choice",
  "title": "Question with choice chips",
  "spec": "07-1 J8; 05 choice card",
  "steps": [
    {
      "do": "send",
      "text": "Help me pick a laptop under 80,000 rupees for programming"
    },
    {
      "do": "waitReply",
      "timeoutMs": 180000,
      "expect": "one reply, no duplicate bubbles, sensible tone and casing",
      "shot": "laptop",
      "expectJs": "(()=>{const log=document.querySelector('[data-testid=\"thread-log\"]');if(!log)return false;const rows=[...log.querySelectorAll('[data-side][data-gap]')];const me=rows.filter((e)=>e.getAttribute('data-side')==='me').at(-1);if(!me)return false;const after=rows.slice(rows.indexOf(me)+1);const c=after.flatMap((r)=>[...r.querySelectorAll('[data-testid=\"card-choice\"]')]).at(-1);return !!c&&c.getAttribute('data-card-state')==='asking'&&c.querySelectorAll('[data-testid=\"card-choice-option\"]').length>=1;})()"
    },
    {
      "do": "check",
      "tid": "card-choice"
    },
    {
      "do": "check",
      "tid": "card-choice-option"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
