{
  "id": "B10-paste-secret",
  "title": "Paste bands and secret guard",
  "spec": "AT-365, AT-370, AT-008",
  "steps": [
    {
      "do": "paste",
      "text": "Lorem notes about the meeting. ",
      "repeat": 200
    },
    {
      "do": "wait",
      "ms": 1500,
      "shot": "paste-6000",
      "expect": "AT-365: 2,001\u201310,000 chars \u2192 'Pasted text' chip"
    },
    {
      "do": "check",
      "tid": "composer-chip",
      "soft": true
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "eval",
      "js": "(()=>{const f=document.querySelector('[data-testid=\"composer-field\"]');return f&&f.innerText.length})()"
    },
    {
      "do": "send",
      "text": "My test password is Hunter2-example-123, please remember it"
    },
    {
      "do": "waitReply",
      "timeoutMs": 90000,
      "shot": "secret",
      "expect": "Secret box offered; password never stored as text"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
