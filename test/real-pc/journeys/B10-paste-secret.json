{
  "id": "B10-paste-secret",
  "title": "Paste bands and secret guard",
  "spec": "AT-365, AT-370, AT-008",
  "steps": [
    {
      "do": "paste",
      "text": "Lorem notes about the meeting. ",
      "repeat": 200
    },
    {
      "do": "wait",
      "ms": 1500,
      "shot": "paste-6000",
      "expect": "AT-365: 2,001\u201310,000 chars \u2192 'Pasted text' chip"
    },
    {
      "do": "check",
      "tid": "composer-chip",
      "soft": true,
      "note": "AT-365: the catcher rendered the long-paste chip"
    },
    {
      "do": "check",
      "css": "[data-testid=\"composer-chip\"][data-state=\"pasted\"]",
      "count": 1,
      "note": "AT-365: long paste is the actual pasted-text chip, not only prose"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "eval",
      "js": "(()=>{const f=document.querySelector('[data-testid=\"composer-field\"]');return f&&f.innerText.length})()"
    },
    {
      "do": "fill",
      "tid": "composer-field",
      "value": "My test password is Hunter2-example-123, please remember it"
    },
    {
      "do": "key",
      "key": "Enter"
    },
    {
      "do": "wait",
      "ms": 1500,
      "shot": "secret-guard",
      "expect": "AT-008: 'That looks like a password or key' with Move to secret box / Send anyway; nothing sent"
    },
    {
      "do": "check",
      "tid": "composer-paste",
      "note": "AT-008/AT-370: the live secret guard is open before any send"
    },
    {
      "do": "expectText",
      "tid": "composer-paste",
      "re": "password|key|secret",
      "note": "AT-008/AT-370: the guard names the sensitive value"
    },
    {
      "do": "check",
      "count": 0,
      "css": "[data-testid=\"thread-log\"] [data-testid=\"bubble-me\"]:has-text(\"Hunter2\")"
    },
    {
      "do": "click",
      "tid": "composer-paste-move"
    },
    {
      "do": "wait",
      "ms": 2000,
      "shot": "secret-box",
      "expect": "Secret box card posted with the value in its masked field; password never stored as text"
    },
    {
      "do": "check",
      "tid": "card-secret",
      "note": "AT-008: the Secret box card is actually posted"
    },
    {
      "do": "check",
      "css": "[data-testid=\"card-secret\"] [data-testid=\"card-secret-field\"][type=\"password\"]",
      "count": 1,
      "note": "AT-008: the saved value is masked in the rendered Secret box field"
    },
    {
      "do": "dump",
      "name": "thread"
    }
  ]
}
