{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F expands PR #101's four-file mutation run across the app boundaries that carry state, jobs, storage, IPC, redaction and provider routing. Scores are valid only when this config executes and the JSON report exists.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": [
    "src/shared/phrases.ts",
    "src/engine/prompt/envelope.ts",
    "src/engine/ai/classify.ts",
    "src/engine/ai/probe.ts",
    "src/shared/redactor.ts",
    "src/shared/schemas.ts",
    "src/shared/approvalMachine.ts",
    "src/shared/jobMachine.ts",
    "src/shared/settingsDefaults.ts",
    "src/engine/ai/AiRegistry.ts",
    "src/engine/ai/parsers.ts",
    "src/engine/ai/verify.ts",
    "src/engine/jobs/JobRunner.ts",
    "src/engine/jobs/recovery.ts",
    "src/engine/jobs/queue.ts",
    "src/engine/jobs/stopFlow.ts",
    "src/engine/gate/GateLogic.ts",
    "src/engine/tools/web/cloudOutbound.ts",
    "src/engine/tools/web/http.ts",
    "src/main/store/db.ts",
    "src/main/store/rebuild.ts",
    "src/main/store/queries.ts",
    "src/main/store/writeRedacted.ts",
    "src/main/ipc/guard.ts",
    "src/main/ipc/IpcRouter.ts",
    "src/main/vault/SecretVault.ts",
    "src/main/vault/registryMirror.ts",
    "src/main/vault/secretIpc.ts",
    "src/main/settings/Settings.ts",
    "src/main/net/netMonitor.ts",
    "src/renderer/store/apply.ts",
    "src/renderer/store/chats.ts",
    "src/renderer/store/messages.ts",
    "src/renderer/store/jobs.ts",
    "src/renderer/store/settings.ts",
    "src/renderer/composer/send.ts",
    "src/renderer/screens/memoryView.ts",
    "src/renderer/shell/actions.ts",
    "src/preload/preload.ts",
    "src/wa-bridge/core.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/lane-f.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/lane-f.json"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "tempDirName": ".stryker-lane-f-tmp",
  "concurrency": 2,
  "timeoutMS": 30000
}
