{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F shared mutation dispatch. Targets are the complete shared partition of stryker.lane-f.config.json; no target is omitted.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.shared.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": [
    "src/shared/phrases.ts",
    "src/shared/redactor.ts",
    "src/shared/schemas.ts",
    "src/shared/approvalMachine.ts",
    "src/shared/jobMachine.ts",
    "src/shared/settingsDefaults.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/lane-f-shared.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/lane-f-shared.json"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "tempDirName": ".stryker-lane-f-shared-tmp",
  "concurrency": 1,
  "timeoutMS": 30000
}
