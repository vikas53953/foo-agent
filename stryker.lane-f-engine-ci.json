{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F engine mutation dispatch. Targets are the complete engine partition of stryker.lane-f.config.json; no target is omitted.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.engine.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": [
    "src/engine/prompt/envelope.ts",
    "src/engine/ai/classify.ts",
    "src/engine/ai/probe.ts",
    "src/engine/ai/AiRegistry.ts",
    "src/engine/ai/parsers.ts",
    "src/engine/ai/verify.ts",
    "src/engine/jobs/JobRunner.ts",
    "src/engine/jobs/recovery.ts",
    "src/engine/jobs/queue.ts",
    "src/engine/jobs/stopFlow.ts",
    "src/engine/gate/GateLogic.ts",
    "src/engine/tools/web/cloudOutbound.ts",
    "src/engine/tools/web/http.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/lane-f-engine.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/lane-f-engine.json"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "tempDirName": ".stryker-lane-f-engine-tmp",
  "concurrency": 2,
  "timeoutMS": 30000
}
