{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F main mutation dispatch. Targets are the complete main partition of stryker.lane-f.config.json; no target is omitted.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.main.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": [
    "src/main/store/db.ts",
    "src/main/store/rebuild.ts",
    "src/main/store/queries.ts",
    "src/main/store/writeRedacted.ts",
    "src/main/ipc/guard.ts",
    "src/main/ipc/IpcRouter.ts",
    "src/main/vault/SecretVault.ts",
    "src/main/vault/registryMirror.ts",
    "src/main/vault/secretIpc.ts",
    "src/main/settings/Settings.ts",
    "src/main/net/netMonitor.ts",
    "src/preload/preload.ts",
    "src/wa-bridge/core.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/lane-f-main.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/lane-f-main.json"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "tempDirName": ".stryker-lane-f-main-tmp",
  "concurrency": 1,
  "timeoutMS": 30000
}
