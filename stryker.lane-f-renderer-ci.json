{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F renderer mutation dispatch. Targets are the complete renderer partition of stryker.lane-f.config.json; no target is omitted.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.renderer.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": [
    "src/renderer/store/apply.ts",
    "src/renderer/store/chats.ts",
    "src/renderer/store/messages.ts",
    "src/renderer/store/jobs.ts",
    "src/renderer/store/settings.ts",
    "src/renderer/composer/send.ts",
    "src/renderer/screens/memoryView.ts",
    "src/renderer/shell/actions.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/lane-f-renderer.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/lane-f-renderer.json"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "tempDirName": ".stryker-lane-f-renderer-tmp",
  "concurrency": 1,
  "timeoutMS": 30000
}
