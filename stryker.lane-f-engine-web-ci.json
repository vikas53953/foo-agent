{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F engine web boundary mutation slice. It is disjoint from engine AI and jobs slices; all base targets remain represented.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.engine-web.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": ["src/engine/tools/web/cloudOutbound.ts", "src/engine/tools/web/http.ts"],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/lane-f-engine-web.html" },
  "jsonReporter": { "fileName": "reports/mutation/lane-f-engine-web.json" },
  "thresholds": { "high": 90, "low": 75, "break": 70 },
  "tempDirName": ".stryker-lane-f-engine-web-tmp",
  "concurrency": 1,
  "timeoutMS": 30000
}
