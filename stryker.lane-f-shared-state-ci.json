{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lane F shared state-machine mutation slice. It is disjoint from the shared redaction slice; all base targets remain represented.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/vitest/vitest.mjs run --bail 1 --config scripts/audit/vitest.mutation.shared-state.config.ts --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "mutate": ["src/shared/approvalMachine.ts", "src/shared/jobMachine.ts"],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/lane-f-shared-state.html" },
  "jsonReporter": { "fileName": "reports/mutation/lane-f-shared-state.json" },
  "thresholds": { "high": 90, "low": 75, "break": 70 },
  "tempDirName": ".stryker-lane-f-shared-state-tmp",
  "concurrency": 1,
  "timeoutMS": 30000
}
