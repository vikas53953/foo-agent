{
  "name": "foo",
  "productName": "foo",
  "version": "0.0.1",
  "private": true,
  "description": "foo, a personal agent for Windows",
  "main": "out/main/main/index.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:tokens": "tsx scripts/build-tokens.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:tokens && pnpm build:main && pnpm build:renderer && tsx scripts/copy-migrations.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:copy": "tsx scripts/check-copy.ts",
    "spec:verify": "tsx scripts/spec-verify.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "node-gyp rebuild --release --directory=node_modules/better-sqlite3",
    "package:dir": "electron-builder --win --dir",
    "golden:manifest": "tsx scripts/golden-manifest.ts",
    "golden:render": "tsx scripts/golden-render.ts",
    "golden:bless": "tsx scripts/golden-bless.ts",
    "tier-r": "tsx scripts/tier-r.ts",
    "fid:guard": "tsx scripts/fid-guard.ts",
    "trace:check": "tsx scripts/trace-check.ts",
    "fidelity:report": "tsx scripts/fidelity-report.ts",
    "closeout": "tsx scripts/closeout.ts",
    "review:tier": "tsx scripts/review-tier.ts",
    "qa": "tsx scripts/qa.ts",
    "qa:explore": "tsx scripts/qa-explore.ts"
  },
  "dependencies": {
    "@fluentui/react-icons": "2.0.343",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/keyring": "2.1.1",
    "@tanstack/react-virtual": "3.14.13",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "13.0.3",
    "immer": "11.1.21",
    "intl-messageformat": "12.1.3",
    "jsdom": "28.1.0",
    "playwright-core": "1.64.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "7.2.4",
    "twitter-text": "3.1.0",
    "uuid": "14.0.3",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "28.0.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@types/twitter-text": "3.1.10",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "node-gyp": "12.4.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
