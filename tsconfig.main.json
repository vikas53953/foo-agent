{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "out/main",
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/main/**/*.ts",
    "src/engine/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.json",
    "src/wa-bridge/**/*.ts"
  ]
}
